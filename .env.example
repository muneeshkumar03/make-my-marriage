# Local demo mode needs no secrets. Set DEMO_MODE=false only when configuring real services.
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=wedding_session
SESSION_SECRET=replace-with-a-long-random-value-before-deploying
GUEST_SESSION_SECRET=replace-with-a-different-long-random-value-before-deploying

# MongoDB Atlas (required for persistence and the background queue when DEMO_MODE=false)
MONGODB_URI=mongodb+srv://username:password@example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=wedding_platform

# Cloudflare R2 S3-compatible API (credentials stay server-side)
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=wedding-photos
R2_PUBLIC_BASE_URL=

# Resend transactional email
RESEND_API_KEY=re_replace-me
EMAIL_FROM=Wedding Team <hello@example.com>

# Worker tuning
WORKER_POLL_INTERVAL_MS=3000
WORKER_ID=local-worker
